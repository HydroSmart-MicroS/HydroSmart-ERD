@startuml
hide circle
hide methods
skinparam shadowing false
skinparam backgroundColor #FFFFFF
skinparam defaultFontName Arial
skinparam defaultFontSize 14
skinparam classFontSize 15
skinparam classFontStyle bold
skinparam classAttributeFontSize 14
skinparam classBorderColor #537278
skinparam classBackgroundColor #F5FBFA
skinparam classFontColor #153A3E
skinparam classAttributeFontColor #183A3E
skinparam ArrowColor #356A70
skinparam ArrowFontColor #204B51
skinparam ArrowFontSize 13
skinparam linetype ortho
skinparam nodesep 26
skinparam ranksep 54
title Metas y recomendaciones
entity "savings_goals" as n_analytics_savings_goals {
  * id : uuid <<PK>>
  --
  * user_id : text <<REF>>
  * month : date
    budget_amount : numeric(12,2)
    target_liters : numeric(18,6)
  * currency : character(3)
    unit_id : uuid <<REF>>
  * notified_80 : boolean
}
entity "recommendations" as n_analytics_recommendations {
  * id : uuid <<PK>>
  --
  * user_id : text <<REF>>
    unit_id : uuid <<REF>>
  * rule_code : text
  * message : text
  * generated_at : timestamptz
}
n_analytics_savings_goals -[hidden]right-> n_analytics_recommendations
legend bottom
PK = clave primaria · FK = clave foránea · UK = clave única · REF = referencia lógica
● = campo obligatorio · Enlaces continuos = FK · Enlaces punteados = REF
endlegend
@enduml
