@startuml
hide circle
hide methods
skinparam shadowing false
skinparam backgroundColor #FFFFFF
skinparam defaultFontName Arial
skinparam defaultFontSize 14
skinparam classFontSize 15
skinparam classFontStyle bold
skinparam classAttributeFontSize 14
skinparam classBorderColor #537278
skinparam classBackgroundColor #F5FBFA
skinparam classFontColor #153A3E
skinparam classAttributeFontColor #183A3E
skinparam ArrowColor #356A70
skinparam ArrowFontColor #204B51
skinparam ArrowFontSize 13
skinparam linetype ortho
skinparam nodesep 26
skinparam ranksep 54
title Reglas, alertas y presencia
entity "alert_rules" as n_analytics_alert_rules {
  * id : uuid <<PK>>
  --
  * user_id : text <<REF>>
    unit_id : uuid <<REF>>
  * kind : text
  * threshold_liters : numeric(18,6)
  * window_seconds : integer
  * enabled : boolean
  * settings : jsonb
}
entity "alerts" as n_analytics_alerts {
  * id : uuid <<PK>>
  --
  * user_id : text <<REF>>
  * unit_id : uuid <<REF>>
    device_id : uuid <<REF>>
    rule_id : uuid <<FK>>
  * kind : text
  * status : text
  * details : jsonb
  * detected_at : timestamptz
    resolved_at : timestamptz
    fingerprint : text <<UK>>
}
entity "alert_samples" as n_analytics_alert_samples {
  * reading_id : uuid <<PK, REF>>
  --
  * unit_id : uuid <<REF>>
  * device_id : uuid <<REF>>
  * liters : numeric(18,6)
  * interval_seconds : integer
  * measured_at : timestamptz
}
entity "device_presence" as n_analytics_device_presence {
  * device_id : uuid <<PK, REF>>
  --
  * unit_id : uuid <<REF>>
  * last_seen_at : timestamptz
  * offline_notified : boolean
}
entity "monitoring_inbox" as n_analytics_monitoring_inbox {
  * event_id : uuid <<PK>>
  --
  * processed_at : timestamptz
}
n_analytics_alert_rules |o--o{ n_analytics_alerts : rule_id
n_analytics_alert_rules -[hidden]right-> n_analytics_alert_samples
n_analytics_alert_samples -[hidden]right-> n_analytics_device_presence
n_analytics_alerts -[hidden]right-> n_analytics_monitoring_inbox
n_analytics_alert_rules -[hidden]down-> n_analytics_alerts
n_analytics_alert_samples -[hidden]down-> n_analytics_monitoring_inbox
legend bottom
PK = clave primaria · FK = clave foránea · UK = clave única · REF = referencia lógica
● = campo obligatorio · Enlaces continuos = FK · Enlaces punteados = REF
endlegend
@enduml
