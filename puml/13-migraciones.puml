  * execution_time : integer
  * success : boolean
}
n_properties_flyway_schema_history -[hidden]right-> n_reports_flyway_schema_history
n_reports_flyway_schema_history -[hidden]right-> n_notifications_flyway_schema_history
n_billing_flyway_schema_history -[hidden]right-> n_analytics_schema_migrations
n_properties_flyway_schema_history -[hidden]down-> n_billing_flyway_schema_history
n_reports_flyway_schema_history -[hidden]down-> n_analytics_schema_migrations
legend bottom
PK = clave primaria · FK = clave foránea · UK = clave única · REF = referencia lógica
● = campo obligatorio · Enlaces continuos = FK · Enlaces punteados = REF
endlegend
