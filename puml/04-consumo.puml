@startuml
hide circle
hide methods
skinparam shadowing false
skinparam backgroundColor #FFFFFF
skinparam defaultFontName Arial
skinparam defaultFontSize 14
skinparam classFontSize 15
skinparam classFontStyle bold
skinparam classAttributeFontSize 14
skinparam classBorderColor #537278
skinparam classBackgroundColor #F5FBFA
skinparam classFontColor #153A3E
skinparam classAttributeFontColor #183A3E
skinparam ArrowColor #356A70
skinparam ArrowFontColor #204B51
skinparam ArrowFontSize 13
skinparam linetype ortho
skinparam nodesep 26
skinparam ranksep 54
title Consumo y deduplicación de lecturas
entity "processed_events" as n_analytics_processed_events {
  * event_id : uuid <<PK, REF>>
  --
  * processed_at : timestamptz
}
entity "processed_readings" as n_analytics_processed_readings {
  * reading_id : uuid <<PK, REF>>
  --
  * event_id : uuid <<UK, FK>>
  * processed_at : timestamptz
}
entity "unit_daily_consumption" as n_analytics_unit_daily_consumption {
  * unit_id : uuid <<PK, REF>>
  * local_date : date <<PK>>
  --
  * timezone : text
  * liters : numeric(18,6)
  * updated_at : timestamptz
}
n_analytics_processed_events ||--o| n_analytics_processed_readings : event_id
n_analytics_processed_events -[hidden]right-> n_analytics_unit_daily_consumption
n_analytics_processed_events -[hidden]down-> n_analytics_processed_readings
legend bottom
PK = clave primaria · FK = clave foránea · UK = clave única · REF = referencia lógica
● = campo obligatorio · Enlaces continuos = FK · Enlaces punteados = REF
endlegend
@enduml
